/* pages/review/review.wxss */
.review-container {
  min-height: 100vh;
  background-color: #F7F7F7;
}

.article-header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  padding: 50rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  display: block;
  line-height: 1.5;
  margin-bottom: 30rpx;
}

.article-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.article-cover {
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.cover-image {
  width: 100%;
  height: 400rpx;
}

.article-content {
  margin: 30rpx;
  padding: 40rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.article-content rich-text {
  font-size: 28rpx;
  color: #333;
  line-height: 2;
}

.article-content rich-text ::v-deep p {
  margin-bottom: 20rpx;
  text-indent: 2em;
}

.article-content rich-text ::v-deep img {
  width: 100%;
  height: auto;
  margin: 20rpx 0;
  border-radius: 12rpx;
}

.article-images {
  margin: 30rpx;
  padding: 30rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.images-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.article-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #F5F5F5;
}

.article-footer {
  margin: 50rpx 30rpx 30rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-divider {
  width: 100rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #DDD 50%, transparent 100%);
  margin-bottom: 30rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.footer-tip {
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 30rpx;
}

.loading-icon,
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #BBB;
}
