<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 个人信息卡片 -->
  <view class="profile-header">
    <image class="user-avatar" src="/images/default-avatar.png" />
    <view class="user-info">
      <text class="user-name">{{userInfo.studentName}}</text>
      <text class="user-grade">{{userInfo.grade}} {{userInfo.class}}</text>
    </view>
    <!-- <view class="edit-btn" bindtap="editProfile">
      <text class="edit-icon">✏️</text>
    </view> -->
  </view>

  <!-- 统计信息 -->
  <!-- <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">{{stats.momentCount}}</text>
      <text class="stat-label">动态</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.likeCount}}</text>
      <text class="stat-label">获赞</text>
    </view>
  </view> -->

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">我的功能</view>
    
    <view class="menu-list">
      <!-- <view class="menu-item" bindtap="viewMyMoments">
        <view class="menu-icon-wrapper" style="background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);">
          <text class="menu-icon">✍️</text>
        </view>
        <text class="menu-text">我的动态</text>
        <text class="menu-arrow">›</text>
      </view> -->

      <view class="menu-item" bindtap="editProfile">
        <view class="menu-icon-wrapper" style="background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);">
          <text class="menu-icon">👤</text>
        </view>
        <text class="menu-text">个人信息</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 我的研学活动 -->
  <view class="activities-section" wx:if="{{myActivities.length > 0}}">
    <view class="menu-title">我的研学活动</view>
    
    <view class="activities-list">
      <view 
        class="activity-item {{activityInfo && item.school_id === activityInfo.school_id && item.act_id === activityInfo.act_id ? 'current' : ''}}"
        wx:for="{{myActivities}}" 
        wx:key="id"
        bindtap="viewActivity"
        data-school_id="{{item.school_id}}"
        data-act_id="{{item.act_id}}"
      >
        <view class="activity-info">
          <text class="activity-name">{{item.activityName}}</text>
          <text class="activity-school">{{item.schoolName}}</text>
          <text class="activity-time">{{item.time}}</text>
        </view>
        <view class="activity-status {{item.status}}">
          {{item.status === 'ongoing' ? '进行中' : '已结束'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section">
    <view class="menu-title">设置</view>
    
    <view class="menu-list">
      <view class="menu-item" bindtap="about">
        <view class="menu-icon-wrapper" style="background: linear-gradient(135deg, #9C27B0 0%, #E91E63 100%);">
          <text class="menu-icon">ℹ️</text>
        </view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="logout">
        <view class="menu-icon-wrapper" style="background: linear-gradient(135deg, #F44336 0%, #E91E63 100%);">
          <text class="menu-icon">🚪</text>
        </view>
        <text class="menu-text">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
