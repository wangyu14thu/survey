<!--pages/preview/preview.wxml-->
<view class="preview-container">
  <!-- 顶部提示 -->
  <view class="preview-header">
    <text class="header-icon">🎯</text>
    <text class="header-title">恭喜你，成功解锁"{{taskInfo.identity}}"身份！</text>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view 
      class="tab-item {{selectedTab === 'challenge' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="challenge"
    >
      <text>挑战</text>
    </view>
    <view 
      class="tab-item {{selectedTab === 'skills' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="skills"
    >
      <text>技能</text>
    </view>
    <view 
      class="tab-item {{selectedTab === 'questions' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="questions"
    >
      <text>问题</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <!-- 挑战 -->
    <view class="content-panel" wx:if="{{selectedTab === 'challenge'}}">
      <view class="panel-card">
        <text class="panel-title">你的挑战</text>
        <text class="panel-text">{{taskInfo.challenge}}</text>
      </view>
    </view>

    <!-- 技能 -->
    <view class="content-panel" wx:if="{{selectedTab === 'skills'}}">
      <view class="panel-card">
        <text class="panel-title">技能清单</text>
        <text class="panel-text">{{taskInfo.skills}}</text>
      </view>
    </view>

    <!-- 问题 -->
    <view class="content-panel" wx:if="{{selectedTab === 'questions'}}">
      <view class="panel-card">
        <text class="panel-title">请回答如下问题开启下一关卡</text>
        
        <view class="questions-list">
          <view class="question-item" wx:for="{{taskInfo.questions}}" wx:key="id">
            <text class="question-text">{{index + 1}}. {{item.question}}</text>
            
            <view class="options-list">
              <view 
                class="option-item {{answers[index] === option.value ? 'selected' : ''}}"
                wx:for="{{item.options}}" 
                wx:key="value"
                wx:for-item="option"
                bindtap="selectAnswer"
                data-index="{{index}}"
                data-option="{{option.value}}"
              >
                <view class="option-radio">
                  <view class="radio-inner" wx:if="{{answers[index] === option.value}}"></view>
                </view>
                <text class="option-text">{{option.label}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 提交按钮 -->
        <button 
          class="btn-submit {{canSubmit ? '' : 'btn-disabled'}}" 
          bindtap="submitAnswer"
          disabled="{{!canSubmit}}"
        >
          提交答案
        </button>
      </view>
    </view>
  </view>
</view>
