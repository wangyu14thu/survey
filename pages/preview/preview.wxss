/* pages/preview/preview.wxss */
.preview-container {
  min-height: 100vh;
  background-color: #F7F7F7;
}

.preview-header {
  background: linear-gradient(135deg, #9C27B0 0%, #E91E63 100%);
  padding: 50rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 40rpx 40rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  text-align: center;
  line-height: 1.5;
}

.tabs {
  display: flex;
  background-color: white;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #9C27B0 0%, #E91E63 100%);
  color: white;
  font-weight: bold;
}

.content-section {
  padding: 0 30rpx 30rpx;
}

.content-panel {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.panel-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.panel-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.questions-list {
  margin-top: 30rpx;
}

.question-item {
  margin-bottom: 40rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.question-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.question-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #F7F7F7;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.option-item.selected {
  background: linear-gradient(135deg, #F3E5F5 0%, #FCE4EC 100%);
  border: 2rpx solid #9C27B0;
}

.option-item:active {
  transform: scale(0.98);
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #DDD;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-item.selected .option-radio {
  border-color: #9C27B0;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  background-color: #9C27B0;
  border-radius: 50%;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.option-item.selected .option-text {
  color: #333;
  font-weight: 500;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #E91E63 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 60rpx;
}

.btn-disabled {
  background: #E0E0E0 !important;
  color: #999 !important;
}
