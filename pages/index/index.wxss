/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #F7F7F7 100%);
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  padding: 40rpx 30rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.2);
}

.school-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.school-name {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.grade-name {
  font-size: 32rpx;
  color: white;
  margin-left: 20rpx;
  font-weight: bold;
}

.activity-name {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  display: block;
  text-align: center;
  line-height: 1.4;
}

.journey-section {
  padding: 40rpx 30rpx;
}

.journey-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.title-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.journey-map {
  position: relative;
  padding: 20rpx 0;
}

.stage-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.stage-item.active {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFF5E5 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.2);
}

.stage-item.completed {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
}

.stage-item.locked {
  opacity: 0.6;
  background-color: #F5F5F5;
}

.stage-item:active:not(.locked) {
  transform: scale(0.98);
}

.stage-marker {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stage-number {
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: #FF6B6B;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.stage-item.locked .stage-number {
  background-color: #BDBDBD;
}

.stage-item.completed .stage-number {
  background-color: #4CAF50;
}

.stage-icon {
  font-size: 56rpx;
}

.stage-name {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stage-name text:first-child {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stage-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stage-item.locked .stage-title {
  color: #999;
}

.stage-line {
  position: absolute;
  left: 79rpx;
  top: 130rpx;
  width: 4rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #FF6B6B 0%, #FFB88C 100%);
}

.stage-item.locked .stage-line {
  background: #E0E0E0;
}

.stage-lock {
  font-size: 40rpx;
  margin-left: 20rpx;
}

.stage-check {
  width: 48rpx;
  height: 48rpx;
  background-color: #4CAF50;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.tips-section {
  padding: 0 30rpx 30rpx;
}

.tip-card {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFE082 100%);
  padding: 30rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 193, 7, 0.2);
}

.tip-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #F57C00;
  line-height: 1.5;
}
