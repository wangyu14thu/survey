/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF8E1 50%, #E3F2FD 100%);
  position: relative;
  overflow: hidden;
}

/* 顶部信息 */
.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 50%, #FFB88C 100%);
  padding: 50rpx 40rpx 60rpx;
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.3);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: headerGlow 3s ease-in-out infinite;
}

@keyframes headerGlow {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

.school-grade {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.school-text,
.grade-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.divider {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin: 0 16rpx;
}

.activity-name {
  font-size: 42rpx;
  font-weight: bold;
  color: white;
  display: block;
  text-align: center;
  line-height: 1.5;
  position: relative;
  z-index: 1;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

/* 研学之旅区域 */
.journey-section {
  padding: 50rpx 30rpx 30rpx;
  position: relative;
}

.journey-title {
  position: relative;
  margin-bottom: 60rpx;
  text-align: center;
}

.title-bg {
  width: 100%;
  height: auto;
  position: absolute;
  top: -20rpx;
  left: 0;
  opacity: 0.1;
}

.title-content {
  position: relative;
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF 0%, #FFF9F0 100%);
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(255,140,83,0.2);
  border: 3rpx solid #FFE0B2;
}

.title-icon {
  font-size: 52rpx;
  margin-right: 16rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 地图装饰 */
.journey-map {
  position: relative;
  padding: 40rpx 20rpx;
}

.map-decoration {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.cloud {
  position: absolute;
  font-size: 60rpx;
  opacity: 0.3;
  animation: float 4s ease-in-out infinite;
}

.cloud-1 {
  top: 50rpx;
  left: 10%;
  animation-delay: 0s;
}

.cloud-2 {
  top: 300rpx;
  right: 15%;
  animation-delay: 2s;
}

.star {
  position: absolute;
  font-size: 40rpx;
  opacity: 0.4;
  animation: twinkle 2s ease-in-out infinite;
}

.star-1 {
  top: 150rpx;
  right: 10%;
  animation-delay: 0.5s;
}

.star-2 {
  bottom: 100rpx;
  left: 15%;
  animation-delay: 1.5s;
}

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); }
  50% { transform: translateY(-20rpx) translateX(10rpx); }
}

@keyframes twinkle {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

/* 站点容器 */
.stages-container {
  position: relative;
  z-index: 1;
}

.stage-wrapper {
  position: relative;
  margin-bottom: 80rpx;
}

.stage-wrapper:last-child {
  margin-bottom: 0;
}

/* 路线连接线 */
.road-line {
  position: absolute;
  left: 50%;
  top: 180rpx;
  width: 8rpx;
  height: 80rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  z-index: 0;
}

.road-dot {
  width: 8rpx;
  height: 8rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  border-radius: 50%;
  animation: roadFlow 1.5s ease-in-out infinite;
}

.stage-wrapper.locked .road-line .road-dot {
  background: #E0E0E0;
  animation: none;
}

.road-dot:nth-child(1) { animation-delay: 0s; }
.road-dot:nth-child(2) { animation-delay: 0.3s; }
.road-dot:nth-child(3) { animation-delay: 0.6s; }
.road-dot:nth-child(4) { animation-delay: 0.9s; }
.road-dot:nth-child(5) { animation-delay: 1.2s; }

@keyframes roadFlow {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 站点卡片 */
.stage-card {
  position: relative;
  background: white;
  border-radius: 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
  border: 3rpx solid transparent;
}

.stage-wrapper.active .stage-card {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFF9E5 100%);
  border-color: #FFE0B2;
  box-shadow: 0 12rpx 40rpx rgba(255,140,83,0.3);
  animation: cardPulse 2s ease-in-out infinite;
}

.stage-wrapper.completed .stage-card {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  border-color: #C8E6C9;
}

.stage-wrapper.locked .stage-card {
  background: linear-gradient(135deg, #F5F5F5 0%, #EEEEEE 100%);
  opacity: 0.7;
}

@keyframes cardPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.stage-card:active:not(.locked) {
  transform: scale(0.95);
}

/* 站点图标容器 */
.station-icon-wrapper {
  position: relative;
  margin-bottom: 30rpx;
}

.station-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 160rpx;
  height: 160rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(255,140,83,0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
  50% { transform: translate(-50%, -50%) scale(1.3); opacity: 0.3; }
}

.station-icon {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  box-shadow: 0 8rpx 24rpx rgba(255,107,107,0.4);
  transition: all 0.3s;
}

.station-icon.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FFD700 100%);
  box-shadow: 0 12rpx 32rpx rgba(255,140,66,0.6);
  animation: iconRotate 3s ease-in-out infinite;
}

.station-icon.completed {
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
  box-shadow: 0 8rpx 24rpx rgba(76,175,80,0.4);
}

.station-icon.locked {
  background: linear-gradient(135deg, #BDBDBD 0%, #9E9E9E 100%);
  box-shadow: 0 4rpx 16rpx rgba(158,158,158,0.3);
}

@keyframes iconRotate {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

.icon-emoji {
  font-size: 70rpx;
  position: relative;
  z-index: 1;
}

/* 站点编号 */
.station-number {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  width: 50rpx;
  height: 50rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #FF6B6B;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  border: 3rpx solid #FFE0B2;
  z-index: 2;
}

.station-icon.locked .station-number {
  color: #9E9E9E;
  border-color: #E0E0E0;
}

.station-icon.completed .station-number {
  color: #4CAF50;
  border-color: #C8E6C9;
}

/* 完成徽章 */
.complete-badge {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.4);
  border: 3rpx solid white;
  z-index: 2;
  animation: badgePop 0.5s ease-out;
}

@keyframes badgePop {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 锁定图标 */
.lock-icon {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 50rpx;
  height: 50rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  border: 3rpx solid #E0E0E0;
  z-index: 2;
}

/* 站点信息 */
.station-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.station-badge {
  background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 100%);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #E65100;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(230,81,0,0.2);
}

.station-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.stage-wrapper.locked .station-name {
  color: #999;
}

/* 状态标签 */
.status-tag {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-tag.active {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFF5E5 100%);
  color: #FF6B6B;
  border: 2rpx solid #FFE0B2;
}

.status-tag.completed {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  color: #4CAF50;
  border: 2rpx solid #C8E6C9;
}

.status-tag.locked {
  background: #F5F5F5;
  color: #999;
  border: 2rpx solid #E0E0E0;
}

/* 点击提示 */
.tap-hint {
  margin-top: 20rpx;
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(255,107,107,0.3);
  animation: tapHintFloat 2s ease-in-out infinite;
}

@keyframes tapHintFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* 温馨提示 */
.tips-section {
  padding: 0 30rpx 50rpx;
}

.tip-card {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFECB3 100%);
  padding: 30rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 8rpx 24rpx rgba(255,193,7,0.3);
  border: 3rpx solid #FFE082;
}

.tip-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255,193,7,0.2);
}

.tip-icon {
  font-size: 36rpx;
  animation: tipBlink 2s ease-in-out infinite;
}

@keyframes tipBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #F57C00;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #E65100;
  line-height: 1.6;
}
