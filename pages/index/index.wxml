<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="school-info">
      <text class="school-name">{{activityInfo.schoolName || ''}}</text>
      <text class="grade-name">{{userInfo.grade || ''}}</text>
    </view>
    <text class="activity-name">{{activityInfo.activityName || '研学活动'}}</text>
  </view>

  <!-- 研学之旅 -->
  <view class="journey-section">
    <view class="journey-title">
      <text class="title-icon">🗺️</text>
      <text class="title-text">我的研学之旅</text>
    </view>

    <!-- 地图路线 -->
    <view class="journey-map">
      <view 
        class="stage-item {{stage.status}}" 
        wx:for="{{stages}}" 
        wx:key="id"
        bindtap="navigateToStage"
        data-url="{{stage.url}}"
        data-status="{{stage.status}}"
      >
        <!-- 站点标记 -->
        <view class="stage-marker">
          <view class="stage-number">{{stage.id}}</view>
          <view class="stage-icon">{{stage.icon}}</view>
        </view>

        <!-- 站点名称 -->
        <view class="stage-name">
          <text>第{{['一','二','三','四'][stage.id-1]}}站</text>
          <text class="stage-title">{{stage.name}}</text>
        </view>

        <!-- 连接线 -->
        <view class="stage-line" wx:if="{{stage.id < 4}}"></view>

        <!-- 锁定状态 -->
        <view class="stage-lock" wx:if="{{stage.status === 'locked'}}">🔒</view>
        
        <!-- 完成状态 -->
        <view class="stage-check" wx:if="{{stage.status === 'completed'}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 温馨提示 -->
  <view class="tips-section">
    <view class="tip-card">
      <text class="tip-icon">💡</text>
      <text class="tip-text">按照站点顺序完成研学任务，解锁下一站</text>
    </view>
  </view>
</view>
