/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  padding: 60rpx 30rpx;
}

.register-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.header-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.register-form {
  background-color: white;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #FF6B6B;
  margin-left: 8rpx;
  font-size: 32rpx;
}

.input {
  height: 88rpx;
  background-color: #F7F7F7;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333;
}

.code-input-wrapper {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.btn-code {
  height: 88rpx;
  background-color: #FF6B6B;
  color: white;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  white-space: nowrap;
}

.picker {
  height: 88rpx;
  background-color: #F7F7F7;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker.placeholder {
  color: #999;
}

.arrow {
  font-size: 48rpx;
  color: #ccc;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 60rpx;
}

.btn-submit:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-disabled {
  background: #E0E0E0 !important;
  color: #999 !important;
}
