<!--pages/register/register.wxml-->
<view class="register-container">
  <!-- Header -->
  <view class="register-header">
    <text class="header-icon">🎒</text>
    <text class="header-title">欢迎参加研学活动</text>
    <text class="header-subtitle">请填写学生信息完成注册</text>
  </view>

  <!-- Form -->
  <view class="register-form">
    <!-- 学生姓名 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">学生姓名</text>
        <text class="required">*</text>
      </view>
      <input 
        class="input" 
        type="text" 
        placeholder="请输入学生姓名"
        value="{{formData.studentName}}"
        bindinput="onStudentNameInput"
      />
    </view>

    <!-- 家长手机号 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">家长手机号</text>
        <text class="required">*</text>
      </view>
      <input 
        class="input" 
        type="number" 
        maxlength="11" 
        placeholder="请输入家长手机号"
        value="{{formData.parentPhone}}"
        bindinput="onParentPhoneInput"
      />
    </view>

    <!-- 短信验证码 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">短信验证码</text>
        <text class="required">*</text>
      </view>
      <view class="code-input-wrapper">
        <input 
          class="input code-input" 
          type="number" 
          maxlength="6" 
          placeholder="请输入验证码"
          value="{{formData.smsCode}}"
          bindinput="onSmsCodeInput"
        />
        <button 
          class="btn-code {{countdown > 0 ? 'btn-disabled' : ''}}" 
          bindtap="getSmsCode"
          disabled="{{countdown > 0}}"
        >
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <!-- 年级 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">年级</text>
        <text class="required">*</text>
      </view>
      <picker 
        mode="selector" 
        range="{{gradeList}}" 
        value="{{gradeIndex}}" 
        bindchange="onGradeChange"
      >
        <view class="picker {{gradeIndex === -1 ? 'placeholder' : ''}}">
          {{gradeIndex === -1 ? '请选择年级' : gradeList[gradeIndex]}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 班级 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">班级</text>
        <text class="required">*</text>
      </view>
      <picker 
        mode="selector" 
        range="{{classList}}" 
        value="{{classIndex}}" 
        bindchange="onClassChange"
      >
        <view class="picker {{classIndex === -1 ? 'placeholder' : ''}}">
          {{classIndex === -1 ? '请选择班级' : classList[classIndex]}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 提交按钮 -->
    <button 
      class="btn-submit {{canSubmit ? '' : 'btn-disabled'}}" 
      bindtap="submitRegister"
      disabled="{{!canSubmit}}"
    >
      立即注册
    </button>
  </view>
</view>
