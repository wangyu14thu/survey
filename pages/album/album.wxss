/* pages/album/album.wxss */
.album-container {
  min-height: 100vh;
  background-color: #F7F7F7;
}

.filter-bar {
  background-color: white;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-label {
  display: flex;
  align-items: center;
}

.label-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.grade-picker {
  min-width: 200rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #F7F7F7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.picker-arrow {
  font-size: 20rpx;
  margin-left: 12rpx;
  color: #999;
}

.album-list {
  padding: 30rpx;
}

.album-card {
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.album-card:active {
  transform: scale(0.98);
}

.album-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.photo-count {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.count-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.count-text {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

.album-info {
  padding: 30rpx;
}

.album-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.album-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-arrow {
  font-size: 32rpx;
  margin-left: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  text-align: center;
  padding: 50rpx 0;
  font-size: 26rpx;
  color: #999;
}
