<!--pages/moment/moment.wxml-->
<view class="moment-container">
  <!-- 动态列表 -->
  <view class="moment-list">
    <view 
      class="moment-card" 
      wx:for="{{moments}}" 
      wx:key="id"
      bindtap="viewMoment"
      data-id="{{item.id}}"
    >
      <!-- 用户信息 -->
      <view class="moment-header">
        <image class="user-avatar" src="{{item.userAvatar || '/images/default-avatar.png'}}" />
        <view class="user-info">
          <text class="user-name">{{item.userName}}</text>
          <text class="user-class">{{item.userClass}}</text>
        </view>
        <text class="moment-time">{{item.timeText}}</text>
      </view>

      <!-- 内容 -->
      <view class="moment-content">
        <text class="content-text">{{item.content}}</text>
      </view>

      <!-- 图片 -->
      <view class="moment-images" wx:if="{{item.images && item.images.length > 0}}">
        <view class="images-grid images-{{item.images.length}}">
          <image 
            class="moment-image" 
            wx:for="{{item.images}}" 
            wx:key="*this"
            wx:for-item="image"
            src="{{image}}" 
            mode="aspectFill"
            catchtap="previewImage"
            data-current="{{image}}"
            data-urls="{{item.images}}"
          />
        </view>
      </view>

      <!-- 互动区 -->
      <view class="moment-actions">
        <view class="action-item">
          <text class="action-icon">👍</text>
          <text class="action-count">{{item.likeCount || 0}}</text>
        </view>
        <view class="action-item">
          <text class="action-icon">💬</text>
          <text class="action-count">{{item.commentCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && moments.length > 0}}">
      <text>已经到底了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{moments.length === 0 && !loading}}">
      <text class="empty-icon">✍️</text>
      <text class="empty-text">还没有人发布动态</text>
      <text class="empty-tip">快来发布第一条动态吧</text>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-btn" bindtap="publishMoment">
    <text class="btn-icon">+</text>
  </view>
</view>
