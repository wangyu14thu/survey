/* pages/album-detail/album-detail.wxss */
.album-detail-container {
  min-height: 100vh;
  background-color: #F7F7F7;
}

.album-header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FFB88C 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.album-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.album-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.photos-waterfall {
  padding: 30rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.photo-item {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.photo-image {
  width: 100%;
  display: block;
  background-color: #F5F5F5;
}

.photo-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
  padding: 20rpx 16rpx 16rpx;
  display: flex;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.3s;
}

.photo-item:active .photo-actions {
  opacity: 1;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  backdrop-filter: blur(10rpx);
}

.action-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 20rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
