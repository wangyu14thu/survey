<!--pages/album-detail/album-detail.wxml-->
<view class="album-detail-container">
  <!-- 相册信息 -->
  <view class="album-header" wx:if="{{album}}">
    <text class="album-title">{{album.title}}</text>
    <view class="album-meta">
      <text class="meta-item">📅 {{album.date}}</text>
      <text class="meta-item">📷 {{photos.length}} 张照片</text>
    </view>
  </view>

  <!-- 瀑布流照片 -->
  <view class="photos-waterfall">
    <view 
      class="photo-item" 
      wx:for="{{photos}}" 
      wx:key="id"
      bindtap="previewPhoto"
      data-index="{{index}}"
    >
      <image 
        class="photo-image" 
        src="{{item.url}}" 
        mode="widthFix"
        lazy-load
      />
      <!-- <view class="photo-actions">
        <view 
          class="action-btn" 
          catchtap="savePhoto"
          data-url="{{item.url}}"
        >
          <text class="action-icon">💾</text>
          <text class="action-text">保存</text>
        </view>
      </view> -->
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{photos.length === 0}}">
    <text class="empty-icon">📷</text>
    <text class="empty-text">暂无照片</text>
  </view>
</view>
