<!--pages/moment-detail/moment-detail.wxml-->
<view class="detail-container" wx:if="{{moment}}">
  <!-- 动态内容 -->
  <view class="moment-section">
    <!-- 用户信息 -->
    <view class="moment-header">
      <image class="user-avatar" src="{{moment.userAvatar || '/images/default-avatar.png'}}" />
      <view class="user-info">
        <text class="user-name">{{moment.userName}}</text>
        <text class="user-class">{{moment.userClass}}</text>
      </view>
      <text class="moment-time">{{moment.timeText}}</text>
    </view>

    <!-- 内容 -->
    <view class="moment-content">
      <text class="content-text">{{moment.content}}</text>
    </view>

    <!-- 图片 -->
    <view class="moment-images" wx:if="{{moment.images && moment.images.length > 0}}">
      <view class="images-grid images-{{moment.images.length}}">
        <image 
          class="moment-image" 
          wx:for="{{moment.images}}" 
          wx:key="*this"
          wx:for-item="image"
          src="{{image}}" 
          mode="aspectFill"
          bindtap="previewImage"
          data-current="{{image}}"
          data-urls="{{moment.images}}"
        />
      </view>
    </view>

    <!-- 互动按钮 -->
    <view class="moment-actions">
      <view class="action-btn {{isLiked ? 'liked' : ''}}" bindtap="toggleLike">
        <text class="action-icon">{{isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{moment.likeCount || 0}}</text>
      </view>
      <view class="action-btn">
        <text class="action-icon">💬</text>
        <text class="action-text">{{moment.commentCount || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 评论列表 -->
  <view class="comments-section">
    <view class="section-title">
      <text class="title-text">评论 ({{comments.length}})</text>
    </view>

    <view class="comments-list">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id">
        <image class="comment-avatar" src="{{item.userAvatar || '/images/default-avatar.png'}}" />
        <view class="comment-content">
          <view class="comment-header">
            <text class="comment-user">{{item.userName}}</text>
            <text class="comment-class">{{item.userClass}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
          <text class="comment-time">{{item.timeText}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-comments" wx:if="{{comments.length === 0}}">
        <text class="empty-icon">💬</text>
        <text class="empty-text">还没有评论,快来抢沙发</text>
      </view>
    </view>
  </view>

  <!-- 评论输入框 -->
  <view class="comment-input-wrapper">
    <input 
      class="comment-input" 
      type="text" 
      placeholder="说点什么吧..."
      value="{{commentInput}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="submitComment"
    />
    <button 
      class="btn-send {{commentInput.length > 0 ? '' : 'btn-disabled'}}" 
      bindtap="submitComment"
      disabled="{{commentInput.length === 0}}"
    >
      发送
    </button>
  </view>
</view>
